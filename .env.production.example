# ==========================================================================
# 生产环境变量模板 —— 复制为 .env.production 并填值：
#     cp .env.production.example .env.production
# 使用：docker compose --env-file .env.production up -d --build
# 不要在未备份和演练恢复前改变 MYSQL_IMAGE。
# .env.production 已被 .gitignore 忽略，切勿提交！
# ==========================================================================

# ---- MySQL ----
MYSQL_IMAGE=mysql:8.0.46
# Docker Hub 受限时，构建命令可传：
# --build-arg NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-slim
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_strong_pwd
MYSQL_DATABASE=exam_system
MYSQL_USER=exam
MYSQL_PASSWORD=CHANGE_ME_exam_strong_pwd

# ---- Auth.js（用 `openssl rand -base64 32` 生成密钥）----
AUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32
AUTH_URL=https://tk.wxlysm.com.cn

# ---- 仅首次空库启动时临时取消注释 ----
# 创建成功后立即从 .env.production 删除这三项并重建 migrate 容器。
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NAME=系统管理员
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_one_time_strong_password
